{
  "manifest_version": 3,
  "name": "EthiScan - AI Privacy & TOS Shield",
  "version": "1.0.0",
  "description": "Automated, AI-powered privacy shield that evaluates Terms of Service and highlights hazardous clauses on live web pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EthiScan Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open EthiScan Dashboard"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/shadow_tooltip.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
